# VideoMind AI Environment Configuration

# Server Port (default: 5000)
PORT=5000

# Maximum video file upload size in Megabytes (default: 150)
MAX_VIDEO_SIZE_MB=150

# Google Gemini API Key for Live Multimodal Video Analysis
# Obtain your free key from: https://aistudio.google.com/
# If left blank, the application will run in safe, fully-functional Demo Simulation Mode
GEMINI_API_KEY=

# Gemini Model to use (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash
